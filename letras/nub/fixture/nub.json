[
    "mkdir -p ~/.local/bin",
    "NUB_INSTALL_DIR=~/.local/share/nub bash -c \"$(curl -fsSL https://nubjs.com/install.sh)\"",
    "ln -fs ~/.local/share/nub/bin/nub ~/.local/bin/nub",
    "ln -fs ~/.local/share/nub/bin/nubx ~/.local/bin/nubx",
    "NUB_INSTALL_DIR=~/.local/share/nub nub -v",
    "NUB_INSTALL_DIR=~/.local/share/nub nubx -v"
]