[
    "mkdir -p ~/.local/bin",
    "wget -c https://github.com/golangci/golangci-lint/releases/download/v2.12.2/golangci-lint-2.12.2-linux-arm64.tar.gz -O ${XDG_CACHE_HOME:-/tmp}/golangci-lint-2.12.2-linux-arm64.tar.gz",
    "rm -rf ~/.local/share/golangci-lint",
    "mkdir -p ~/.local/share/golangci-lint",
    "tar xf ${XDG_CACHE_HOME:-/tmp}/golangci-lint-2.12.2-linux-arm64.tar.gz -C ~/.local/share",
    "rm ${XDG_CACHE_HOME:-/tmp}/golangci-lint-2.12.2-linux-arm64.tar.gz",
    "ln -fs ~/.local/share/golangci-lint/bin/golangci-lint ~/.local/bin/golangci-lint"
]