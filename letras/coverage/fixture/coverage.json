[
    "mkdir -p ~/.local/bin",
    "mkdir -p ~/.local/share/coverage",
    "wget https://github.com/coderaiser/go-coverage/releases/download/v1.1.0/coverage_1.1.0_linux_arm64 -O ~/.local/share/coverage/coverage",
    "ln -fs ~/.local/share/coverage/coverage ~/.local/bin/coverage",
    "[ -e ~/.local/share/coverage-linux-arm64 ] && rm -rf ~/.local/share/coverage || true",
    "[ -e ~/.local/share/coverage-linux-arm64 ] && mv -f ~/.local/share/coverage-linux-arm64 ~/.local/share/coverage || true",
    "chmod +x ~/.local/share/coverage/coverage",
    "coverage --version"
]