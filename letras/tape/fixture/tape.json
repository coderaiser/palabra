[
    "mkdir -p ~/.local/bin",
    "mkdir -p ~/.local/share/tape",
    "wget https://github.com/coderaiser/go-tape/releases/download/v1.0.1/tape_1.0.1_linux_arm64 -O ~/.local/share/tape/tape",
    "ln -fs ~/.local/share/tape/tape ~/.local/bin/tape",
    "[ -e ~/.local/share/tape-linux-arm64 ] && rm -rf ~/.local/share/tape || true",
    "[ -e ~/.local/share/tape-linux-arm64 ] && mv -f ~/.local/share/tape-linux-arm64 ~/.local/share/tape || true",
    "chmod +x ~/.local/share/tape/tape",
    "tape --version"
]