{
    "name": "yara",
    "version": "1.22.1",
    "url": "https://github.com/VirusTotal/yara-x/releases/download/v{{ version }}/yara-x-v{{ version }}-{{ arch }}-unknown-linux-gnu.tar.gz",
    "bin": {
        "yara": "yr",
        "yr": "yr"
    },
    "test": [
        "yara --version",
        "yr --version"
    ],
    "commands": [
        "mkdir -p {{ directorio }}/yara",
        "mv {{ directorio }}/yr {{ directorio }}/yara/"
    ],
    "alias": {
        "arch": {
            "x64": "x86_64",
            "arm64": "aarch64"
        }
    }
}