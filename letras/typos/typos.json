{
    "name": "typos",
    "version": "1.51.1",
    "url": {
        "darwin": "https://github.com/crate-ci/typos/releases/download/v{{ version }}/typos-v{{ version }}-{{ arch }}-apple-darwin.tar.gz",
        "linux": "https://github.com/crate-ci/typos/releases/download/v{{ version }}/typos-v{{ version }}-{{ arch }}-unknown-linux-musl.tar.gz"
    },
    "bin": "{{ name }}",
    "extractDirectory": "{{ directorio }}/{{ name }}",
    "test": "{{ name }} --version",
    "alias": {
        "arch": {
            "x64": "x86_64",
            "arm64": "aarch64"
        }
    }
}
