[
    "mkdir -p ~/.local/bin",
    "wget -c https://github.com/go-task/task/releases/download/v3.52.0/task_linux_arm64.tar.gz -O ${XDG_CACHE_HOME:-/tmp}/task_linux_arm64.tar.gz",
    "rm -rf ~/.local/share/task",
    "mkdir -p ~/.local/share/task",
    "tar xf ${XDG_CACHE_HOME:-/tmp}/task_linux_arm64.tar.gz -C ~/.local/share",
    "rm ${XDG_CACHE_HOME:-/tmp}/task_linux_arm64.tar.gz",
    "ln -fs ~/.local/share/task/task ~/.local/bin/task"
]